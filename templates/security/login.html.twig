{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="container">
        <div class="form-page form-page--narrow">
            <div class="form-card">
                <h1 class="form-card__title">Connexion</h1>
                <p class="form-card__subtitle">Heureux de vous revoir ! Connectez-vous pour accéder aux figurines.</p>

                {% if error %}
                    <div class="login-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}">
                    <div class="form-group">
                        <label for="username" class="form-label required">Adresse e-mail</label>
                        <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" placeholder="vous@exemple.com" required autofocus>
                    </div>

                    <div class="form-group">
                        <label for="password" class="form-label required">Mot de passe</label>
                        <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button class="btn btn--primary btn--block" type="submit">Se connecter</button>
                </form>

                <p class="form-footer">Pas encore de compte ? <a href="{{ path('app_register') }}">S'inscrire</a></p>
            </div>
        </div>
    </div>
{% endblock %}
