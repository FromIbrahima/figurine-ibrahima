{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}
    <div class="container">
        <div class="form-page">
            <div class="form-card">
                <h1 class="form-card__title">Modifier mon profil</h1>
                <p class="form-card__subtitle">Vous pouvez changer votre image de profil, votre prénom et votre nom.</p>

                <div class="profile__current-avatar">
                    <img src="{{ asset('uploads/users/' ~ user.imageName) }}" alt="Image de profil actuelle">
                    <span>Image de profil actuelle</span>
                </div>

                {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}

                    {{ form_row(form.imageFile) }}

                    <div class="form-row-2">
                        {{ form_row(form.firstname) }}
                        {{ form_row(form.lastname) }}
                    </div>

                    {{ form_rest(form) }}

                    <div class="actions">
                        <button type="submit" class="btn btn--primary">Enregistrer</button>
                        <a href="{{ path('app_account') }}" class="btn btn--ghost">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
