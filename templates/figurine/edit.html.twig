{% extends 'base.html.twig' %}

{% block title %}Modifier « {{ figurine.title }} »{% endblock %}

{% block body %}
    <div class="container">
        <div class="form-page">
            <div class="form-card">
                <h1 class="form-card__title">Modifier la figurine</h1>
                <p class="form-card__subtitle">Laissez le champ image vide pour conserver la photo actuelle.</p>

                {{ include('figurine/_form.html.twig', {
                    button_label: 'Enregistrer les modifications',
                    cancel_path: path('app_figurine_show', {id: figurine.id}),
                }) }}
            </div>
        </div>
    </div>
{% endblock %}
